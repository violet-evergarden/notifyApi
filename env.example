# API 密钥配置
# 用于验证请求的 API 密钥
API_KEY=f3808faa-8147-41ee-9795-e1c04ddf319e

# Telegram Bot 配置
# Telegram Bot 的 Chat ID（需要先发送消息给 Bot 才能获取）
NOTIFY_BOT_CHAT_ID=your-chat-id-here

# Telegram Bot API URL
# 格式: https://api.telegram.org/bot<your-bot-token>/
# 示例: https://api.telegram.org/bot123456789:ABCdefGHIjklMNOpqrsTUVwxyz/
NOTIFY_BOT_URL=https://api.telegram.org/bot<your-bot-token>/

# 服务端口配置（可选，默认: 8848）
PORT=8848

# Node.js 环境（可选，默认: production）
NODE_ENV=production

